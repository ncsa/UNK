# Secrets: never bake into the image (users.csv is mounted at runtime; the server
# needs no API keys).
**/*_key.txt
users.csv
setup.sh

# High scores live in data/, which is mounted so they survive rebuilds.
data/

# Generation inputs and caches the server doesn't read: the raw sprite frames (the built
# sheets in build/characters are what it serves), raw ElevenLabs audio, audition reels.
Characters/*/frames/
Sounds/raw/
Sounds/audition/

# Working material the game doesn't serve.
Images/
Misc/
Prompts.txt
SplastScreen.jpeg

# The asset tools run on your machine, never in the image.
add_character.py
make_sounds.py
check_gemini.py
requirements.txt

# Python / venv / build cruft.
__pycache__/
*.pyc
.venv/
venv/

# VCS, OS, editor, Claude.
.git/
.gitignore
.DS_Store
**/.DS_Store
.claude/
*.log
