# Secrets: never bake into the image (users.csv is mounted at runtime; the server
# needs no API keys).
**/*_key.txt
users.csv
setup.sh

# High scores live in data/, which is mounted so they survive rebuilds.
data/

# Generation caches the server doesn't read: raw ElevenLabs audio, audition reels.
# (Characters/*/frames stay: the image builds the sprite sheets from them, then drops them.)
Sounds/raw/
Sounds/audition/
# Local builds: the image makes its own sheets, and arenas are rebuilt on demand.
build/

# Working material the game doesn't serve.
Images/
Misc/
Prompts.txt
SplastScreen.jpeg

# The asset tools run on your machine. (add_character.py and requirements.txt are needed
# to build the sheets; the Dockerfile removes them from the final image.)
make_sounds.py
check_gemini.py

# Python / venv / build cruft.
__pycache__/
*.pyc
.venv/
venv/

# VCS, OS, editor, Claude.
.git/
.gitignore
.DS_Store
**/.DS_Store
.claude/
*.log
